{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spartan-atlas",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "vars": {
    "TURSO_DATABASE_URL": "libsql://spartanatlas-8noh.aws-ap-northeast-1.turso.io"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
